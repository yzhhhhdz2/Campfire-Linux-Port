* text=auto

*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.slnx    text eol=crlf
*.manifest text eol=crlf
*.md      text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf

*.png binary
*.jpg binary
*.ico binary

# Linux port: upstream Windows sources are CRLF, but everything under linux/ is
# consumed on Linux (shell scripts, Mappings *.txt, classpath, C# generated by
# Windows-side tooling). Keep these LF on checkout; binary rules above stay intact.
linux/**/*.cs      text eol=lf
linux/**/*.axaml   text eol=lf
linux/**/*.csproj  text eol=lf
linux/**/*.txt     text eol=lf
linux/**/*.json    text eol=lf
linux/**/*.xml     text eol=lf
linux/**/*.in      text eol=lf
linux/**/*.desktop text eol=lf
# No-extension launcher: without this it falls back to * text=auto and a
# Windows clone turns it into CRLF, which breaks AppRun on Linux.
linux/release/AppRun text eol=lf
# Legacy obfuscation tables are consumed verbatim on Linux; keep LF everywhere.
src/Campfire/Link/Minecraft/Mappings/*.txt text eol=lf

